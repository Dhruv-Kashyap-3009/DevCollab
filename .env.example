# ---------------------------------------------------------------------------
# DevCollab — Docker environment template
# Copy to .env (root) and replace every placeholder. Never commit .env.
#   PowerShell:  Copy-Item .env.example .env
#   CMD:         copy .env.example .env
# ---------------------------------------------------------------------------

# --- Backend ---------------------------------------------------------------
PORT=3000
# Only used when you run `npm run dev` against a local, unauthenticated mongod.
# docker compose builds MONGO_URI itself from the MONGO_* values below.
MONGO_URI=mongodb://localhost:27017/devcollab

# --- MongoDB (docker compose) ----------------------------------------------
# Created inside the container on the FIRST start of an empty data volume.
# Changing them later requires recreating the volume (`docker compose down -v`).
MONGO_ROOT_USERNAME=devcollab_root
MONGO_ROOT_PASSWORD=change_me_root_password
MONGO_APP_USER=devcollab
# Used by the backend; keep it URL-safe (letters, digits, - and _) because it is
# embedded in a mongodb:// URI. It is NOT the root password.
MONGO_APP_PASSWORD=change_me_app_password

# Secrets: generate with `openssl rand -base64 48` (or any 32+ random chars).
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=change_me_to_a_different_long_random_string_32_chars
# Must be EXACTLY 32 characters (AES-256 key for GitHub token encryption).
ENCRYPTION_KEY=change_me_exactly_32_characters!

# Frontend origin used for invite links and CORS.
# Production (docker-compose.yml): http://localhost
# Development (docker-compose.dev.yml): http://localhost:5173
CLIENT_URL=http://localhost
# Public URL of the backend, used to build the GitHub webhook URL.
API_URL=http://localhost:3000

# --- Email invites (SMTP via Nodemailer) -----------------------------------
# Gmail address + 16-character Google App Password (not your normal password).
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: Resend HTTP API takes priority over SMTP when set.
EMAIL_API_KEY=
EMAIL_FROM=DevCollab <onboarding@resend.dev>

# --- HTTPS (optional, docker-compose.tls.yml) ------------------------------
# `localhost` -> Caddy's internal CA (browser warning until you trust it).
# A real domain whose DNS points here -> automatic Let's Encrypt certificate,
# and then CLIENT_URL/API_URL must use https:// that domain.
DOMAIN=localhost

# --- Frontend (build-time; optional) ---------------------------------------
# Leave unset so the SPA calls the same origin (/api, proxied by nginx).
# VITE_API_URL=/api
# VITE_WS_URL=
